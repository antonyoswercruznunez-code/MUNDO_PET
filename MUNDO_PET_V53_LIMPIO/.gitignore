# Dependencias
node_modules/

# Credenciales y configuración local
.env
.env.*
!.env.public

# Archivos temporales y registros
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Archivos generados durante la ejecución
storage/tmp/
storage/private/
public/uploads/tmp/
coverage/

# Copias y paquetes locales
*.zip
*.rar
*.7z

# Respaldos locales de la base (contienen datos reales)
database/backup_*.sql

# Capturas y registros de Playwright
.playwright-mcp/

# Documentos generados (cotizaciones, notas de venta): contienen datos de clientes
storage/documents/*
!storage/documents/.gitkeep

# Permisos locales de Claude Code en este equipo
.claude/settings.local.json

# Imágenes subidas desde el panel o la tienda (dependen de la base local;
# los comprobantes de pago contienen datos de clientes)
public/uploads/sliders/*
public/uploads/productos/*
public/uploads/pagos/*
public/uploads/qr/*
!public/uploads/**/.gitkeep
